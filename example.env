# Nauti Nodes Testbed 1 — Volunteer Worker Environment Template
# Copy to .env or export before starting nauti-nodes worker

# Coordinator endpoint URL (Set by testbed operator)
NAUTI_COORDINATOR_URL="http://10.0.0.61:8099"

# Local inference engine URL (llama-server or compatible OpenAI endpoint)
LOCAL_INFERENCE_URL="http://127.0.0.1:5200"

# Node Role & Model Assignment
NAUTI_WORKER_ROLE="thinker"
NAUTI_WORKER_ID="volunteer-gpu-01"

# Persistent Ed25519 node identity storage location (chmod 0600)
NAUTI_IDENTITY_PATH="$HOME/.config/nauti/identity.json"

# Strict physical GPU discovery requirement (Disables synthetic fallbacks)
NAUTI_STRICT_ALPHA="true"

# External Alpha Public Workload Policy Enforcement
NAUTI_IS_EXTERNAL_ALPHA="true"

# Optional: Admin Key (For coordinator operators only — leave empty for volunteer nodes)
# NAUTI_ADMIN_KEY=""
